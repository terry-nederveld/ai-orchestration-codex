{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fable",
  "version": "0.1.0",
  "identifier": "dev.fable.orchestrator",
  "build": {
    "beforeDevCommand": "npm run build:sidecar",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist-ui"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Fable",
        "width": 1380,
        "height": 880,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/fable-control-plane"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Provider-neutral autonomous agent orchestration",
    "longDescription": "Turn work from GitHub, Jira, and Linear into isolated, observable software-delivery workflows."
  }
}
