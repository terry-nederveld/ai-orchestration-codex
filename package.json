{
  "name": "@fable/orchestrator",
  "version": "0.1.0",
  "description": "Cross-platform, provider-neutral autonomous agent orchestration",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "fable": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "dist-ui",
    "schemas",
    "workflows",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:ui",
    "build:core": "tsc -p tsconfig.build.json",
    "build:ui": "vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev": "tsx src/cli/index.ts",
    "dev:desktop": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:adrs": "node --experimental-strip-types scripts/validate-adrs.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.9",
    "@modelcontextprotocol/sdk": "^1.17.3",
    "@openai/codex-sdk": "^0.89.0",
    "@tauri-apps/api": "^2.8.0",
    "commander": "^14.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
