{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fable.local/schemas/workflow.schema.json",
  "title": "Fable workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "steps"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "lifecycle": { "enum": ["DRAFT", "ENABLED", "DISABLED"], "default": "ENABLED" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "includes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "states": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includeLabels": { "type": "array", "items": { "type": "string" } },
        "excludeLabels": { "type": "array", "items": { "type": "string" } }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": ["git-worktree", "clone", "local", "temporary"]
        },
        "retainOnFailure": { "type": "boolean" }
      }
    },
    "variables": { "type": "object" },
    "domainStates": { "type": "array", "items": { "type": "string" }, "default": [] },
    "assets": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/assetReference" }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "providers": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "configuration": { "type": "object", "default": {} },
    "budgets": { "$ref": "#/$defs/budgets" },
    "agents": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/agent" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success": { "type": "string" },
        "failure": { "type": "string" },
        "cancelled": { "type": "string" }
      }
    }
  },
  "$defs": {
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "digest"],
      "properties": {
        "kind": {
          "enum": [
            "workflow",
            "subworkflow",
            "gate_set",
            "rubric",
            "agent_profile",
            "policy",
            "template"
          ]
        },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxConcurrentAgents": { "type": "integer", "minimum": 1 },
        "maxSubagentsPerRun": { "type": "integer", "minimum": 0 },
        "maxIterations": { "type": "integer", "minimum": 1 },
        "maxWallClockMs": { "type": "integer", "minimum": 1 },
        "maxInputTokens": { "type": "integer", "minimum": 1 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "maxEstimatedCostUsd": { "type": "number", "minimum": 0 },
        "maxSubscriptionRequests": { "type": "integer", "minimum": 0 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "enum": [
              "chat",
              "reasoning",
              "tool_use",
              "parallel_tool_use",
              "structured_output",
              "vision",
              "web_search",
              "computer_use",
              "code_execution",
              "long_context",
              "context_compaction",
              "subagents",
              "background_tasks",
              "mcp",
              "skills",
              "hooks",
              "streaming",
              "resume_session"
            ]
          }
        },
        "instructions": { "type": "string" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20 },
        "backoffMs": { "type": "integer", "minimum": 0 },
        "maxBackoffMs": { "type": "integer", "minimum": 0 }
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["while", "maxIterations"],
      "properties": {
        "while": { "type": "string", "minLength": 1 },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "commonStep": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "join": {
          "oneOf": [
            {
              "type": "object",
              "required": ["mode"],
              "properties": { "mode": { "const": "all" } }
            },
            {
              "type": "object",
              "required": ["mode"],
              "properties": { "mode": { "const": "any" } }
            },
            {
              "type": "object",
              "required": ["mode", "count"],
              "properties": {
                "mode": { "const": "minimum" },
                "count": { "type": "integer", "minimum": 1 }
              }
            },
            {
              "type": "object",
              "required": ["mode", "required"],
              "properties": {
                "mode": { "const": "named" },
                "required": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              }
            }
          ]
        },
        "when": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "retry": { "$ref": "#/$defs/retry" },
        "repeat": { "$ref": "#/$defs/repeat" },
        "outputSchema": { "type": "object" },
        "onEnter": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycleAction" },
          "default": []
        },
        "onExit": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycleAction" },
          "default": []
        },
        "onError": { "enum": ["fail", "continue"] }
      }
    },
    "lifecycleAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "input": { "type": "object", "default": {} }
      }
    },
    "step": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/commonStep" },
            {
              "required": ["agent", "goal"],
              "properties": {
                "type": { "const": "agent" },
                "agent": { "type": "string" },
                "goal": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonStep" },
            {
              "required": ["command"],
              "properties": {
                "type": { "const": "command" },
                "command": { "type": "string", "minLength": 1 },
                "args": { "type": "array", "items": { "type": "string" } },
                "cwd": { "type": "string" },
                "env": { "type": "object", "additionalProperties": { "type": "string" } },
                "expectedExitCodes": { "type": "array", "items": { "type": "integer" } }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonStep" },
            {
              "required": ["tool"],
              "properties": {
                "type": { "const": "tool" },
                "tool": { "type": "string" },
                "input": { "type": "object" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonStep" },
            {
              "required": ["action"],
              "properties": {
                "type": { "const": "action" },
                "action": { "type": "string" },
                "input": { "type": "object" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonStep" },
            {
              "required": ["title", "description"],
              "properties": {
                "type": { "const": "approval" },
                "title": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonStep" },
            {
              "required": ["inputType", "title", "description"],
              "properties": {
                "type": { "const": "human_input" },
                "inputType": {
                  "enum": [
                    "text",
                    "boolean",
                    "single_choice",
                    "multiple_choice",
                    "approval",
                    "secret",
                    "file_reference",
                    "free_form"
                  ]
                },
                "title": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "channel": { "enum": ["app", "work_item", "both"] },
                "required": { "type": "boolean" },
                "choices": { "type": "array", "items": { "type": "string" } },
                "secretDestination": { "type": "string" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonStep" },
            {
              "required": ["conditionType"],
              "properties": {
                "type": { "const": "wait" },
                "conditionType": {
                  "enum": [
                    "time",
                    "external_event",
                    "dependency",
                    "provider_availability",
                    "work_item_event"
                  ]
                },
                "predicate": { "type": "object" },
                "until": { "type": "string", "format": "date-time" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/commonStep" },
            {
              "required": ["workflow"],
              "properties": {
                "type": { "const": "subworkflow" },
                "workflow": { "$ref": "#/$defs/assetReference" },
                "input": { "type": "object" },
                "failure": { "enum": ["fail", "continue"] }
              }
            }
          ]
        }
      ]
    }
  }
}
